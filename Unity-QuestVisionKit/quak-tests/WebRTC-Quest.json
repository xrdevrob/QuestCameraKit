{
  "schema_version": 1,
  "name": "WebRTC-Quest startup check",
  "description": "Observes sample startup without an external signaling server. Does not prove streaming or peer connectivity.",
  "target": "quest",
  "expected_application_id": "com.xrdevrob.questcamerakit.webrtcquest",
  "expected_scene": "WebRTC-Quest",
  "visual_evidence": {
    "required": true,
    "capture_policy": "unattended",
    "fps": 2,
    "max_duration_seconds": 20,
    "focus_clips": "marked-and-failures",
    "target_highlight": "focused-clips"
  },
  "steps": [
    {
      "id": "observe-sample",
      "provider": "unity",
      "tool": "quak_get_state",
      "arguments": {},
      "wait_timeout_seconds": 15,
      "poll_interval_seconds": 0.5,
      "assertions": [
        {
          "path": "$.data.data.result.state.quest-camera-kit.scene",
          "op": "equals",
          "expected": "WebRTC-Quest"
        },
        {
          "path": "$.data.data.result.state.quest-camera-kit.errorCount",
          "op": "equals",
          "expected": 0
        }
      ],
      "failure_guidance": "Check camera permissions, headset focus, scene references, and device logs; a running app without fresh camera frames is not a pass."
    }
  ]
}
