{
  "schema_version": 1,
  "name": "QRCodeDetection device camera and runtime check",
  "description": "Observes the real sample camera and processing pipeline. This does not assert semantic detection accuracy or a user interaction.",
  "target": "quest",
  "expected_application_id": "com.xrdevrob.questcamerakit.qrcodedetection",
  "expected_scene": "QRCodeDetection",
  "visual_evidence": {
    "required": true,
    "capture_policy": "unattended",
    "fps": 2,
    "max_duration_seconds": 20,
    "focus_clips": "marked-and-failures",
    "target_highlight": "focused-clips"
  },
  "steps": [
    {
      "id": "observe-sample",
      "provider": "unity",
      "tool": "quak_get_state",
      "arguments": {},
      "wait_timeout_seconds": 15,
      "poll_interval_seconds": 0.5,
      "assertions": [
        {
          "path": "$.data.data.result.state.quest-camera-kit.scene",
          "op": "equals",
          "expected": "QRCodeDetection"
        },
        {
          "path": "$.data.data.result.state.quest-camera-kit.errorCount",
          "op": "equals",
          "expected": 0
        },
        {
          "path": "$.data.data.result.state.quest-camera-kit.nativeQrSupported",
          "op": "equals",
          "expected": true
        }
      ],
      "failure_guidance": "Check camera permissions, headset focus, scene references, and device logs; a running app without fresh camera frames is not a pass."
    }
  ]
}
