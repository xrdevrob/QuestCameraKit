{
  "schema_version": 1,
  "name": "Native QR tracking with a visible real QR code",
  "description": "Requires spatial-data permission, native tracking support, enabled tracking, and at least one QR trackable emitted by MRUK. Hold a known QR code in view and review its payload and alignment visually.",
  "target": "quest",
  "expected_application_id": "com.xrdevrob.questcamerakit.qrcodedetection",
  "expected_scene": "QRCodeDetection",
  "visual_evidence": {
    "required": true,
    "capture_policy": "unattended",
    "fps": 2,
    "max_duration_seconds": 20,
    "focus_clips": "marked-and-failures",
    "target_highlight": "focused-clips"
  },
  "steps": [
    {
      "id": "observe-sample",
      "provider": "unity",
      "tool": "quak_get_state",
      "arguments": {},
      "wait_timeout_seconds": 15,
      "poll_interval_seconds": 0.5,
      "assertions": [
        {
          "path": "$.data.data.result.state.quest-camera-kit.scene",
          "op": "equals",
          "expected": "QRCodeDetection"
        },
        {
          "path": "$.data.data.result.state.quest-camera-kit.errorCount",
          "op": "equals",
          "expected": 0
        },
        {
          "path": "$.data.data.result.state.quest-camera-kit.nativeQrSupported",
          "op": "equals",
          "expected": true
        },
        {
          "path": "$.data.data.result.state.quest-camera-kit.nativeQrHasPermissions",
          "op": "equals",
          "expected": true
        },
        {
          "path": "$.data.data.result.state.quest-camera-kit.nativeQrTrackingEnabled",
          "op": "equals",
          "expected": true
        },
        {
          "path": "$.data.data.result.state.quest-camera-kit.nativeQrTrackedCount",
          "op": "gte",
          "expected": 1
        }
      ],
      "failure_guidance": "Check native QR runtime support, spatial-data permission, and the tracking toggle. Hold a real QR code in view. A supported API without a tracked QR code is not a pass."
    }
  ]
}
